# =====================================================================
# Job Miner local development environment
# Copy this file to .env and replace secrets before running the stack.
# Do not commit .env.
# =====================================================================

# Application runtime
JOB_MINER_ENV=local
JOB_MINER_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOB_MINER_ALLOW_DEV_AUTH_FALLBACK=false

# PostgreSQL
POSTGRES_USER=job_miner_app
POSTGRES_PASSWORD=job_miner_password
POSTGRES_DB=job_miner_control
JOB_MINER_POSTGRES_URL=postgresql+psycopg://job_miner_app:job_miner_password@localhost:5432/job_miner_control
JOB_MINER_POSTGRES_POOL_SIZE=5
JOB_MINER_POSTGRES_MAX_OVERFLOW=10
JOB_MINER_POSTGRES_POOL_RECYCLE_SECONDS=1800

# MongoDB
MONGO_INITDB_ROOT_USERNAME=job_miner
MONGO_INITDB_ROOT_PASSWORD=job_miner
JOB_MINER_MONGO_URI=mongodb://job_miner:job_miner@localhost:27017/?authSource=admin
JOB_MINER_MONGO_DB=job_miner

# Redis and Celery
JOB_MINER_REDIS_URL=redis://localhost:6379/0
JOB_MINER_CELERY_BROKER_URL=redis://localhost:6379/0
JOB_MINER_CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_MINER_RECOMMENDATION_QUEUE=recommendation_queue
JOB_MINER_RESUME_PROCESSING_QUEUE=resume_processing_queue
# sync keeps the existing blocking upload behavior. async returns HTTP 202 and processes OCR/profile extraction in Celery.
JOB_MINER_RESUME_UPLOAD_MODE=sync
JOB_MINER_ENABLE_AUTO_RECOMMENDATION_QUEUE=true

# Automated candidate recommendations after resume upload
JOB_MINER_AUTO_RECOMMENDATION_TOP_N=50
JOB_MINER_AUTO_INDEX_JOBS_AFTER_UPLOAD=true
JOB_MINER_AUTO_BUILD_JOB_TOWERS_IF_EMPTY=true
JOB_MINER_AUTO_LLM_RERANK_AFTER_UPLOAD=true
JOB_MINER_AUTO_LLM_RERANK_TOP_K=50
JOB_MINER_AUTO_LLM_RERANK_FINAL_TOP_N=50
JOB_MINER_LLM_RERANKER_MODEL=qwen2.5:7b
JOB_MINER_LLM_RERANK_TIMEOUT_SECONDS=1800
JOB_MINER_LLM_RERANK_CHUNK_SIZE=3
JOB_MINER_LLM_RERANK_NUM_CTX=8192
JOB_MINER_LLM_RERANK_NUM_PREDICT=4096

# Qdrant and embeddings
JOB_MINER_QDRANT_URL=http://localhost:6333
JOB_MINER_QDRANT_API_KEY=
JOB_MINER_JOBS_COLLECTION=job_miner_jobs
JOB_MINER_CANDIDATES_COLLECTION=job_miner_candidates
JOB_MINER_OLLAMA_URL=http://localhost:11434
JOB_MINER_EMBEDDING_MODEL=embeddinggemma
JOB_MINER_EMBEDDING_BATCH_SIZE=16
JOB_MINER_MAX_CHARS_PER_TEXT=12000
OLLAMA_PROVIDER=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_TOKEN=ollama

# Keycloak admin and database
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=job_miner_app
KC_DB_PASSWORD=job_miner_password
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true

# Keycloak public config used by FastAPI and frontend
JOB_MINER_KEYCLOAK_ENABLED=true
JOB_MINER_KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080
JOB_MINER_KEYCLOAK_REALM=job-miner
JOB_MINER_KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/job-miner
JOB_MINER_KEYCLOAK_JWKS_URL=http://localhost:8080/realms/job-miner/protocol/openid-connect/certs
JOB_MINER_KEYCLOAK_AUDIENCE=job-miner-api
JOB_MINER_KEYCLOAK_CLIENT_ID=job-miner-web
JOB_MINER_KEYCLOAK_JWT_LEEWAY_SECONDS=30
# Local/dev bypass: keep false because SMTP is not configured locally.
# Production: set true only after JOB_MINER_KEYCLOAK_SMTP_* values are configured and tested.
JOB_MINER_KEYCLOAK_VERIFY_EMAIL=false
# Local/dev backend bypass so Keycloak tokens without email_verified=true can still upload resumes.
# Production: keep false and rely on real Keycloak email verification.
JOB_MINER_BYPASS_EMAIL_VERIFICATION_FOR_LOCAL_DEV=true
JOB_MINER_DEFAULT_ORG_CODE=default

# Keycloak SMTP placeholders. Configure these before enabling JOB_MINER_KEYCLOAK_VERIFY_EMAIL=true.
JOB_MINER_KEYCLOAK_SMTP_HOST=
JOB_MINER_KEYCLOAK_SMTP_PORT=587
JOB_MINER_KEYCLOAK_SMTP_FROM=no-reply@jobminer.local
JOB_MINER_KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Job Miner
JOB_MINER_KEYCLOAK_SMTP_REPLY_TO=
JOB_MINER_KEYCLOAK_SMTP_AUTH=true
JOB_MINER_KEYCLOAK_SMTP_USER=
JOB_MINER_KEYCLOAK_SMTP_PASSWORD=
JOB_MINER_KEYCLOAK_SMTP_STARTTLS=true
JOB_MINER_KEYCLOAK_SMTP_SSL=false

# Google OAuth client for Keycloak Identity Provider.
# Create these in Google Cloud Console -> APIs and Services -> Credentials.
# Local redirect URI:
# http://localhost:8080/realms/job-miner/broker/google/endpoint
GOOGLE_CLIENT_ID=<>
GOOGLE_CLIENT_SECRET=<>

# API request observability
# Backend always generates its own UUID request_id and ignores incoming X-Request-ID values.
# DB logging is sampled for successful GETs so high-volume polling does not overload Postgres.
JOB_MINER_API_REQUEST_DB_LOGGING=true
JOB_MINER_API_REQUEST_LOG_SAMPLE_RATE=0.05
JOB_MINER_API_REQUEST_LOG_SUCCESSFUL_GETS=false
JOB_MINER_API_REQUEST_LOG_5XX=true
JOB_MINER_API_REQUEST_LOG_MUTATIONS=true

# Admin-added job portal production workers/scheduler
JOB_MINER_FLEET_CONTROL_QUEUE=fleet_control
JOB_MINER_SOURCE_DISCOVERY_QUEUE=source_discovery
JOB_MINER_JOB_DETAIL_QUEUE=job_detail
JOB_MINER_JOB_PERSISTENCE_QUEUE=job_persistence
JOB_MINER_RECONCILIATION_QUEUE=reconciliation
JOB_MINER_SCRAPE_RETRY_QUEUE=retry
JOB_MINER_SCRAPE_DEAD_LETTER_QUEUE=dead_letter
JOB_MINER_RECOMMENDATION_REFRESH_QUEUE=recommendation_refresh_queue
JOB_MINER_PORTAL_SCHEDULER_BATCH_SIZE=10
JOB_MINER_PORTAL_TEST_SCRAPE_MAX_JOBS=5
JOB_MINER_PORTAL_SCHEDULER_INTERVAL_SECONDS=300
JOB_MINER_RECOMMENDATION_REFRESH_INTERVAL_SECONDS=900
JOB_MINER_ENABLE_PORTAL_BEAT=0
JOB_MINER_PORTAL_RECOMMENDATION_REFRESH_CANDIDATE_LIMIT=250
# Candidate application agent
JOB_MINER_APPLICATION_ORCHESTRATION_QUEUE=application_orchestration_queue
JOB_MINER_APPLICATION_JOB_QUEUE=application_job_queue
# Keep false until portal-specific ATS strategies are implemented and legally approved.
JOB_MINER_APPLICATION_AGENT_ENABLE_EXTERNAL_SUBMIT=false

# StrategicStaff demo automation. This submits real applications when enabled.
JOB_MINER_APPLICATION_AGENT_AUTOSUBMIT_DOMAINS=careers.strategicstaff.com,strategicstaff.com
JOB_MINER_APPLICATION_AGENT_HEADLESS=true
JOB_MINER_APPLICATION_AGENT_BROWSER_TIMEOUT_MS=45000
JOB_MINER_APPLICATION_AGENT_SLOW_MO_MS=0
JOB_MINER_APPLICATION_AGENT_MAX_RESUME_BYTES=3145728
